{
	"name": "electrobun-react-tailwind-vite",
	"version": "1.0.0",
	"description": "Electrobun app with React, Tailwind CSS, and Vite HMR",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
		"hmr": "vite --port 5173",
		"build:canary": "vite build && electrobun build --env=canary",
		"typecheck": "tsgo --noEmit"
	},
	"dependencies": {
		"@legendapp/list": "^3.3.3",
		"@tanstack/react-query": "^5.101.2",
		"@tanstack/react-router": "^1.170.18",
		"axios": "^1.18.1",
		"daisyui": "^5.6.18",
		"electrobun": "1.18.1",
		"googleapis": "^173.0.0",
		"jotai": "^2.20.2",
		"lucide-react": "^1.24.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-hook-form": "^7.81.0",
		"sharp": "^0.35.3",
		"systeminformation": "^5.31.17",
		"use-debounce": "^10.1.1",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.2",
		"@tanstack/router-plugin": "^1.168.20",
		"@types/bun": "latest",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/three": "^0.185.1",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"@vitejs/plugin-react": "^4.3.4",
		"concurrently": "^9.1.0",
		"tailwindcss": "^4.3.2",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	}
}
