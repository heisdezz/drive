{
  "name": "electrobun-react-tailwind-vite",
  "version": "1.0.0",
  "description": "Electrobun app with React, Tailwind CSS, and Vite HMR",
  "scripts": {
    "start": "vite build &&  electrobun dev",
    "dev": "vite build && electrobun dev --watch",
    "dev:hmr": "vite build && concurrently \"bun run hmr\" \"bun run dev\"",
    "dev:electrobun": "LIBVA_DRIVER_NAME=iHD DRI_PRIME=0 WEBKIT_WEB_RENDER_DEVICE_FILE=/dev/dri/renderD128 WEBKIT_DMABUF_RENDERER_FORCE_SHM=1 electrobun dev",
    "hmr": "vite --port 5173",
    "build:canary": "vite build && electrobun build --env=canary",
    "build:stable": "vite build && electrobun build --env=stable",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@legendapp/list": "^3.6.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/solid-query": "^5.104.3",
    "@tanstack/solid-router": "^1.170.41",
    "axios": "^1.20.0",
    "daisyui": "^5.7.50",
    "electrobun": "1.18.1",
    "googleapis": "^173.0.0",
    "jotai": "^2.20.3",
    "lucide-react": "^1.58.0",
    "lucide-solid": "^1.58.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-fps-stats": "^0.3.2",
    "react-hook-form": "^7.90.0",
    "react-scan": "^0.5.7",
    "sharp": "^0.35.5",
    "solid-js": "^1.9.17",
    "systeminformation": "^5.33.15",
    "use-debounce": "^10.1.1",
    "vite-plugin-solid": "^2.11.14",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.46",
    "@types/bun": "latest",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.185.4",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
